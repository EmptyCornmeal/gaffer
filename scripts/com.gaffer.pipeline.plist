<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd job for the Mac Mini. Runs the Gaffer refresh twice a day
  (07:30 and 18:30 local). Edit REPO_PATH, then:

    cp scripts/com.gaffer.pipeline.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.gaffer.pipeline.plist

  Check logs at /tmp/gaffer.out / /tmp/gaffer.err.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gaffer.pipeline</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/scripts/refresh.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/gaffer.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gaffer.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
